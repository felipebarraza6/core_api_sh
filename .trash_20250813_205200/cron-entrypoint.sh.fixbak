#!/bin/bash
echo "🚀 Iniciando cronjobs SmartHydro con configuración Django..."

# Configurar variables de entorno para Django y cron
export DJANGO_SETTINGS_MODULE=api.settings
export LOCAL_DB_HOST="${LOCAL_DB_HOST}"
export LOCAL_DB_NAME=${LOCAL_DB_NAME:-smarthydro_prod}
export LOCAL_DB_USER=${LOCAL_DB_USER:-smarthydro_user}
export LOCAL_DB_PASSWORD=${LOCAL_DB_PASSWORD}

# Escribir variables en /etc/environment para cron

# Configurar archivos de logs
mkdir -p /tmp/smarthydro
touch /tmp/smarthydro/twin_1.log /tmp/smarthydro/twin_5.log /tmp/smarthydro/twin_60.log
touch /tmp/smarthydro/nettra_5.log /tmp/smarthydro/nettra_60.log
touch /tmp/smarthydro/novus_60.log /tmp/smarthydro/dga.log /tmp/smarthydro/sma.log /tmp/smarthydro/alerts.log

# Instalar cronjobs de Django
echo "⚙️ Instalando cronjobs de Django..."
/usr/local/bin/python manage.py crontab add

# Mostrar cronjobs instalados
echo "📋 Cronjobs instalados:"
crontab -l

# Iniciar cron en primer plano
echo "🔄 Iniciando cron daemon..."
exec cron -f
