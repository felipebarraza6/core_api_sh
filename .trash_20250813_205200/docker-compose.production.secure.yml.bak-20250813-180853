version: "3.8"

services:
  # ========================================
  # NGINX PROXY - FRONTEND SEGURO
  # ========================================
  nginx_proxy:
    image: jwilder/nginx-proxy:latest
    container_name: nginx_proxy
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/tmp/docker.sock:ro
      # - ./conf/nginx-proxy.conf:/etc/nginx/conf.d/default.conf:ro
      - nginx_proxy_certs:/etc/nginx/certs:ro
      - nginx_proxy_vhost:/etc/nginx/vhost.d:ro
      - nginx_proxy_html:/usr/share/nginx/html:ro
    networks:
      - frontend
    restart: unless-stopped
    # ✅ SEGURIDAD: Usuario no-root
    # user: "101:101"
    # ✅ SEGURIDAD: Healthcheck
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # ========================================
  # LETSENCRYPT - SSL AUTOMÁTICO
  # ========================================
  letsencrypt:
    image: jrcs/letsencrypt-nginx-proxy-companion:latest
    container_name: letsencrypt
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - nginx_proxy_certs:/etc/nginx/certs:rw
      - nginx_proxy_vhost:/etc/nginx/vhost.d:rw
      - nginx_proxy_html:/usr/share/nginx/html:rw
      - letsencrypt_data:/etc/acme.sh
    environment:
      - NGINX_PROXY_CONTAINER=nginx_proxy
    networks:
      - frontend
    depends_on:
      - nginx_proxy
    restart: unless-stopped
    # ✅ SEGURIDAD: Usuario no-root
    # user: "101:101"

  # ========================================
  # POSTGRESQL 15 - ULTRA-SEGURO
  # ========================================
  postgres:
    image: postgres:15-alpine
    container_name: postgres_secure
    environment:
      POSTGRES_DB: smarthydro_prod
      POSTGRES_USER: smarthydro_user
      POSTGRES_PASSWORD: ${LOCAL_DB_PASSWORD}
      # ✅ SEGURIDAD: Variables adicionales
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-db-secure.sql:/docker-entrypoint-initdb.d/init-db-secure.sql:ro
      - postgres_logs:/var/lib/postgresql/data/log
    networks:
      - backend
    restart: unless-stopped
    # ✅ SEGURIDAD: Healthcheck robusto
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U smarthydro_user -d smarthydro_prod"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    # ✅ SEGURIDAD: Usuario no-root
    user: "999:999"
    # ✅ SEGURIDAD: Capabilities limitadas
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    # ✅ SEGURIDAD: Read-only root filesystem
    read_only: true
    # ✅ SEGURIDAD: Volumes temporales
    tmpfs:
      - /tmp
      - /var/run/postgresql

  # ========================================
  # API DJANGO - API.SMARTHYDRO.APP
  # ========================================
  django:
    build: .
    container_name: django_api_secure
    environment:
      - LOCAL_DB_NAME=smarthydro_prod
      - LOCAL_DB_USER=smarthydro_user
      - LOCAL_DB_PASSWORD=${LOCAL_DB_PASSWORD}
      - LOCAL_DB_HOST=postgres_secure
      - LOCAL_DB_PORT=5432
      - VIRTUAL_HOST=${VIRTUAL_HOST}
      - LETSENCRYPT_HOST=${LETSENCRYPT_HOST}
      - LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL}
      - DJANGO_DEBUG=False
      - USE_CLUSTER=false
      # ✅ SEGURIDAD: Variables adicionales
      - DJANGO_ALLOWED_HOSTS=${VIRTUAL_HOST}
      - DJANGO_CSRF_TRUSTED_ORIGINS=https://${VIRTUAL_HOST}
      - DJANGO_SECURE_SSL_REDIRECT=True
      - DJANGO_SECURE_HSTS_SECONDS=31536000
      - DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
      - DJANGO_SECURE_HSTS_PRELOAD=True
      - DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
      - DJANGO_SECURE_BROWSER_XSS_FILTER=True
      - DJANGO_SECURE_FRAME_DENY=True
      - DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
    volumes:
      - django_static:/app/staticfiles
      - django_media:/app/media
      - django_logs:/app/logs
    depends_on:
      postgres:
        condition: service_healthy
      nginx_proxy:
        condition: service_started
      letsencrypt:
        condition: service_started
    networks:
      - frontend
      - backend
    restart: unless-stopped
    # ✅ SEGURIDAD: Healthcheck
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    # ✅ SEGURIDAD: Usuario no-root
    # user: "1000:1000"
    # ✅ SEGURIDAD: Capabilities limitadas
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    # ✅ SEGURIDAD: Read-only root filesystem
    # ✅ SEGURIDAD: Volumes temporales
    tmpfs:
      - /tmp
      - /var/tmp
      - /var/spool/cron
    command: ["cron"]

# ========================================

  # ========================================
  # CRON JOBS - SOLO LOCAL SEGURO
  # ========================================
  cron:
    build: .
    container_name: cron_jobs_secure
    entrypoint: /usr/local/bin/cron-entrypoint.sh
    environment:
      - LOCAL_DB_NAME=smarthydro_prod
      - LOCAL_DB_USER=smarthydro_user
      - LOCAL_DB_PASSWORD=${LOCAL_DB_PASSWORD}
      - LOCAL_DB_HOST=postgres_secure
      - LOCAL_DB_PORT=5432
      - USE_CLUSTER=false
      - DJANGO_DEBUG=False
      - DJANGO_ALLOWED_HOSTS=localhost
    volumes:
      - cron_logs:/var/log/smarthydro
      - django_logs:/app/logs
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend
      - default
    restart: unless-stopped
    user: "1000:1000"
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
    tmpfs:
      - /tmp
      - /var/tmp
    command: ["cron"]
    dns:
      - 8.8.8.8
      - 8.8.4.4
# VOLUMENES PERSISTENTES SEGUROS
# ========================================
volumes:
  postgres_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/postgres_data
  postgres_logs:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/postgres_logs
  django_static:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/django_static
  django_media:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/django_media
  django_logs:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/django_logs
  cron_logs:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/smarthydro/cron_logs
  nginx_proxy_certs:
    driver: local
  nginx_proxy_vhost:
    driver: local
  nginx_proxy_html:
    driver: local
  letsencrypt_data:
    driver: local

# ========================================
# REDES SEGURAS
# ========================================
networks:
  frontend:
    driver: bridge
    # ✅ SEGURIDAD: Red aislada
    ipam:
      config:
        - subnet: 172.20.0.0/16
  backend:
    driver: bridge
    # ✅ SEGURIDAD: Red privada
    internal: true
    ipam:
      config:
        - subnet: 172.21.0.0/16

# ========================================
# CRON JOBS - DNS FIJO PARA RESOLVER API
# ========================================
