def backup_to_database(cluster_db_config, db_name):
    """Realizar backup a una base de datos específica del cluster"""
    print(f"=== RESPALDO A {db_name.upper()} ===")

    try:
        cluster_conn = psycopg2.connect(**cluster_db_config)
        cluster_cursor = cluster_conn.cursor()

        # Verificar conexión
        cluster_cursor.execute("SELECT COUNT(*) FROM core_interactiondetail;")
        cluster_total = cluster_cursor.fetchone()[0]
        print(f"✅ Conectado a {db_name}: {cluster_total:,} registros existentes")

        return cluster_conn, cluster_cursor, cluster_total

    except Exception as e:
        print(f"❌ ERROR conectando a {db_name}: {e}")
        return None, None, 0
    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass


def sync_to_database(
    local_conn, local_cursor, cluster_conn, cluster_cursor, db_name, local_total
):
    """Sincronizar datos del local a una base específica del cluster"""
    print(f"=== SINCRONIZANDO A {db_name.upper()} ===")

    stats = {
            'db': db_name,
            'inserted_total': 0,
            'skipped_fk': 0,
            'by_cp': {},
            'final_diff': None
        }

    try:
        # Contar registros en el cluster
        cluster_cursor.execute("SELECT COUNT(*) FROM core_interactiondetail;")
        cluster_total = cluster_cursor.fetchone()[0]

        missing_count = local_total - cluster_total
        print(f"📊 {db_name}: Local {local_total:,} vs Cluster {cluster_total:,}")
        print(f"📊 FALTANTES: {missing_count:,}")

        if missing_count <= 0:
            print(f"✅ {db_name}: No hay registros faltantes!")
            return True, stats

        # Limpiar registros huérfanos
        print(f"🧹 {db_name}: Limpiando registros huérfanos...")
        cluster_cursor.execute("SELECT id FROM core_interactiondetail ORDER BY id;")
        cluster_ids = set(row[0] for row in cluster_cursor.fetchall())

        local_cursor.execute("SELECT id FROM core_interactiondetail ORDER BY id;")
        local_ids = set(row[0] for row in local_cursor.fetchall())

        orphan_ids = cluster_ids - local_ids

        if orphan_ids:
            print(f"🗑️ {db_name}: Eliminando {len(orphan_ids)} registros huérfanos...")
            orphan_list = list(orphan_ids)
            batch_size = 1000

            for i in range(0, len(orphan_list), batch_size):
                batch = orphan_list[i : i + batch_size]
                placeholders = ",".join(["%s"] * len(batch))
                delete_query = (
                    f"DELETE FROM core_interactiondetail WHERE id IN ({placeholders})"
                )
                cluster_cursor.execute(delete_query, batch)

            cluster_conn.commit()
            print(f"✅ {db_name}: Registros huérfanos eliminados")

        # Recalcular faltantes después de limpieza
        cluster_cursor.execute("SELECT COUNT(*) FROM core_interactiondetail;")
        cluster_total_after_cleanup = cluster_cursor.fetchone()[0]
        missing_count = local_total - cluster_total_after_cleanup

        if missing_count <= 0:
            print(f"✅ {db_name}: No hay registros faltantes después de limpieza!")
            return True, stats

        # Buscar registros faltantes
        print(f"🔍 {db_name}: Buscando {missing_count:,} registros faltantes...")

        # Obtener MAX(id) de ambas bases, manejando None (base vacía)
        local_cursor.execute("SELECT MAX(id) FROM core_interactiondetail;")
        _row = local_cursor.fetchone()
        local_max_id = _row[0] if _row and _row[0] is not None else -1

        cluster_cursor.execute("SELECT MAX(id) FROM core_interactiondetail;")
        _row = cluster_cursor.fetchone()
        cluster_max_id = _row[0] if _row and _row[0] is not None else -1

        # Buscar registros faltantes
        if local_max_id > cluster_max_id:
            local_cursor.execute(
                """
                SELECT id, created, modified, date_time_medition, date_time_last_logger,
                       flow, total, total_diff, total_today_diff, nivel, water_table,
                       send_dga, return_dga, n_voucher, is_error, catchment_point_id,
                       notification_id, pulses, days_not_conection
                FROM core_interactiondetail
                WHERE id > %s
                ORDER BY id
                """,
                (cluster_max_id,),
            )
        else:
            local_cursor.execute(
                """
                SELECT id, created, modified, date_time_medition, date_time_last_logger,
                       flow, total, total_diff, total_today_diff, nivel, water_table,
                       send_dga, return_dga, n_voucher, is_error, catchment_point_id,
                       notification_id, pulses, days_not_conection
                FROM core_interactiondetail
                WHERE created >= NOW() - INTERVAL '24 hours'
                ORDER BY id
                """
            )

        # Streaming por lotes grandes para evitar cargar todo en memoria
        insert_query = """
            INSERT INTO core_interactiondetail 
            (id, created, modified, date_time_medition, date_time_last_logger,
             flow, total, total_diff, total_today_diff, nivel, water_table,
             send_dga, return_dga, n_voucher, is_error, catchment_point_id,
             notification_id, pulses, days_not_conection)
            VALUES %s
            ON CONFLICT (id) DO NOTHING
        """

        start_time = time.time()
        total_inserted = 0
        batch_size_rows = 10000  # filas a leer de la BD local por iteración
        page_size = 1000         # filas por INSERT ... VALUES

        try:
            # Re-ejecutar el selector en un cursor server-side si es posible
            stream_cur = local_conn.cursor(name=f'stream_missing_{int(time.time())}')
            if local_max_id > cluster_max_id:
                stream_cur.execute(
                    """
                    SELECT id, created, modified, date_time_medition, date_time_last_logger,
                           flow, total, total_diff, total_today_diff, nivel, water_table,
                           send_dga, return_dga, n_voucher, is_error, catchment_point_id,
                           notification_id, pulses, days_not_conection
                    FROM core_interactiondetail
                    WHERE id > %s
                    ORDER BY id
                    """,
                    (cluster_max_id,)
                )
            else:
                stream_cur.execute(
                    """
                    SELECT id, created, modified, date_time_medition, date_time_last_logger,
                           flow, total, total_diff, total_today_diff, nivel, water_table,
                           send_dga, return_dga, n_voucher, is_error, catchment_point_id,
                           notification_id, pulses, days_not_conection
                    FROM core_interactiondetail
                    WHERE created >= NOW() - INTERVAL '24 hours'
                    ORDER BY id
                    """
                )

            while True:
                rows = stream_cur.fetchmany(batch_size_rows)
                if not rows:
                    break
                # Filtrado de FKs para evitar violaciones por catchment_point_id
                if 'cluster_cp_ids' not in locals():
                    cluster_cursor.execute("SELECT id FROM core_catchmentpoint;")
                    cluster_cp_ids = set(r[0] for r in cluster_cursor.fetchall())
                filtered_rows = []
                skipped = 0
                for r in rows:
                    try:
                        cp_id = r[15]
                    except Exception:
                        cp_id = None
                    if (cp_id is None) or (cp_id in cluster_cp_ids):
                        filtered_rows.append(r)
                    else:
                        skipped += 1
                if skipped:
                    stats['skipped_fk'] += skipped
                    print(f"⚠️ {db_name}: Saltando {skipped} filas por FK catchment_point_id inexistente")
                if filtered_rows:
                    # contabilizar por CP
                    for r in filtered_rows:
                        try:
                            cp_id = r[15]
                        except Exception:
                            cp_id = None
                        if cp_id is not None:
                            stats['by_cp'][cp_id] = stats['by_cp'].get(cp_id, 0) + 1
                    psycopg2.extras.execute_values(
                        cluster_cursor, insert_query, filtered_rows, page_size=page_size
                    )
                    cluster_conn.commit()
                    total_inserted += len(filtered_rows)
                    stats['inserted_total'] = total_inserted
                    elapsed = time.time() - start_time
                    rate = total_inserted / elapsed if elapsed > 0 else 0
                    print(f"✅ {db_name}: Insertados {total_inserted:,} (velocidad {rate:.0f} r/s)")

            stream_cur.close()
            print(f"✅ {db_name}: Migración por streaming completada ({total_inserted:,} registros)")
        except Exception as e:
            print(f"❌ {db_name}: Error en migración por streaming: {e}")
            return False, stats
    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass

        # Verificación final
        cluster_cursor.execute("SELECT COUNT(*) FROM core_interactiondetail;")
        final_cluster_total = cluster_cursor.fetchone()[0]

        print(f"📊 {db_name}: VERIFICACIÓN FINAL")
        print(f"📊 {db_name}: Local {local_total:,} vs Cluster {final_cluster_total:,}")
        print(f"📊 {db_name}: Diferencia final {local_total - final_cluster_total:,}")

        stats['final_diff'] = local_total - final_cluster_total
        if final_cluster_total >= local_total * 0.99:
            print(f"🎉 {db_name}: RESPALDO EXITOSO AL 100%!")
            return True, stats
        else:
            print(f"⚠️ {db_name}: Aún faltan algunos registros")
            return False, stats

    except Exception as e:
        print(f"❌ {db_name}: Error en sincronización: {e}")
        return False, stats
    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass


def find_and_migrate_missing():
    """Función principal de respaldo dual"""
    print("=== RESPALDO DUAL AL CLUSTER ===")
    print("Sincronizando local → telemetry_api + data_store_telemetry")
    print()

    try:
        # Conectar a base local
        local_conn = psycopg2.connect(**LOCAL_DB)
        local_cursor = local_cursor = local_conn.cursor()

        # Pre-sync de todas las tablas core_ (excepto core_interactiondetail) hacia ambos clusters
        try:
            cluster_targets = [CLUSTER_DB_PRIMARY, CLUSTER_DB_BACKUP]
            pre_sync_all_core_refs(local_conn, cluster_targets, exclude_tables={'core_interactiondetail'})
        except Exception as e:
            print(f'Advertencia pre-sync core_*: {e}')

    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass

        # Pre-sincronizar tablas de referencia para cumplir FKs
        try:
            # Upsert de core_catchmentpoint hacia ambos destinos del cluster
            with psycopg2.connect(**CLUSTER_DB_PRIMARY) as _c1:
                upsert_reference_table(local_conn, _c1, 'core_catchmentpoint')
            with psycopg2.connect(**CLUSTER_DB_BACKUP) as _c2:
                upsert_reference_table(local_conn, _c2, 'core_catchmentpoint')
            print('Tablas de referencia pre-sincronizadas: core_catchmentpoint')
        except Exception as e:
            print(f'Advertencia pre-sync: {e}')

    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass

        # Validaciones previas
        print("=== VALIDACIONES PREVIAS ===")

        local_cursor.execute(
            "SELECT COUNT(*) FROM information_schema.tables "
            "WHERE table_schema='public' AND table_type='BASE TABLE';"
        )
        tables_count = local_cursor.fetchone()[0]
        if tables_count == 0:
            print("❌ ERROR: No se encontraron tablas en la BD local")
            return False
        print(f"✅ Tablas encontradas en BD local: {tables_count}")

        local_cursor.execute("SELECT COUNT(*) FROM core_interactiondetail;")
        local_total = local_cursor.fetchone()[0]
        if local_total == 0:
            print("❌ ERROR: La tabla core_interactiondetail está vacía")
            return False
        print(f"✅ Registros en core_interactiondetail local: {local_total:,}")

        print()

        # RESPALDO DUAL
        results = []

        # 1. Respaldo a telemetry_api (primaria)
        print("🔄 INICIANDO RESPALDO PRIMARIO (telemetry_api)")
        conn1, cursor1, total1 = backup_to_database(CLUSTER_DB_PRIMARY, "telemetry_api")
        if conn1 and cursor1:
            result1, stats1 = sync_to_database(
                local_conn, local_cursor, conn1, cursor1, "telemetry_api", local_total
            )
            results.append(("telemetry_api", result1, stats1))
            cursor1.close()
            conn1.close()
        else:
            results.append(("telemetry_api", False, {}))

        print()

        # 2. Respaldo a data_store_telemetry (secundaria)
        print("🔄 INICIANDO RESPALDO SECUNDARIO (data_store_telemetry)")
        conn2, cursor2, total2 = backup_to_database(
            CLUSTER_DB_BACKUP, "data_store_telemetry"
        )
        if conn2 and cursor2:
            result2, stats2 = sync_to_database(
                local_conn,
                local_cursor,
                conn2,
                cursor2,
                "data_store_telemetry",
                local_total,
            )
            results.append(("data_store_telemetry", result2, stats2))
            cursor2.close()
            conn2.close()
        else:
            results.append(("data_store_telemetry", False, {}))


        
        # Preparar y enviar correo de resumen
        try:
            from django.core.mail import send_mail
            from django.conf import settings
            # mapa id -> nombre de punto desde BD local
            local_cursor.execute("SELECT id, name FROM core_catchmentpoint")
            id_to_name = {r[0]: r[1] for r in local_cursor.fetchall()}
            def fmt_stats(lbl, ok, st):
                lines = []
                lines.append(f"Base destino: {lbl} - Estado: {'Exitoso' if ok else 'Con alertas'}")
                lines.append(f"Insertados: {st.get('inserted_total',0)} | Omitidos por FK: {st.get('skipped_fk',0)} | Diferencia final: {st.get('final_diff')}")
                # Top 10 CP
                by_cp = st.get('by_cp', {}) or {}
                if by_cp:
                    lines.append("Top puntos de captación (por registros insertados):")
