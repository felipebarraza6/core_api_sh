            body_lines = [
                f"Resumen de sincronización core_",
                f"Fecha/Hora: {time.strftime('%Y-%m-%d %H:%M:%S %Z')}",
                "",
            ]
            for db_name, ok, st in results:
                body_lines.append(fmt_stats(db_name, ok, st))
                body_lines.append("")
            body = "\n".join(body_lines)
            subject = f"[Cluster Backup] Resumen sincronización core_ {time.strftime('%Y-%m-%d %H:%M')}"
            recipients = ['felipebarraza@smarthydro.cl']
            send_mail(subject, body, settings.DEFAULT_FROM_EMAIL, recipients, fail_silently=False)
            print("✉️ Resumen enviado a felipebarraza@smarthydro.cl")
        except Exception as e:
            print(f"Error enviando correo de resumen: {e}")

