def upsert_reference_table(local_conn, cluster_conn, table_name, pk='id'):
    """Upsert de una tabla de referencia core_ desde local -> cluster.
    Obtiene columnas desde information_schema y sincroniza filas faltantes por PK."""
    with local_conn.cursor() as lcur, cluster_conn.cursor() as ccur:
        cols_sql = (
            "SELECT column_name FROM information_schema.columns "
            "WHERE table_schema='public' AND table_name=%s ORDER BY ordinal_position"
        )
        lcur.execute(cols_sql, (table_name,))
        cols = [r[0] for r in lcur.fetchall()]
        if not cols:
            print(f"{table_name}: sin columnas en local; se omite")
            return 0
        col_list = ', '.join(cols)
        placeholders = ', '.join(['%s'] * len(cols))
        update_set = ', '.join([f"{c}=EXCLUDED.{c}" for c in cols if c != pk])
        # IDs ya presentes en cluster
        ccur.execute(f"SELECT {pk} FROM {table_name}")
        cluster_ids = {r[0] for r in ccur.fetchall()}
        # Filas locales candidatas
        lcur.execute(f"SELECT {col_list} FROM {table_name}")
        rows = lcur.fetchall()
        missing = [r for r in rows if r[0] not in cluster_ids]
        if not missing:
            print(f"{table_name}: sin filas faltantes")
            return 0
        insert_sql = (
            f"INSERT INTO {table_name} ({col_list}) VALUES ({placeholders}) "
            f"ON CONFLICT ({pk}) DO UPDATE SET {update_set}"
        )
        batch = 1000
        total = 0
        for i in range(0, len(missing), batch):
            chunk = missing[i:i+batch]
            ccur.executemany(insert_sql, chunk)
            cluster_conn.commit()
            total += len(chunk)
        print(f"{table_name}: upsert completado ({total} filas)")
        return total


def get_core_tables_and_deps(conn):
    """Devuelve (tables, deps) para tablas core_ en public.
    deps[a] = set(tablas de las que a depende vía FK)."""
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT tc.table_name AS src_table,
                   kcu.column_name AS src_col,
                   ccu.table_name AS ref_table,
                   ccu.column_name AS ref_col
            FROM information_schema.table_constraints AS tc
            JOIN information_schema.key_column_usage AS kcu
              ON tc.constraint_name = kcu.constraint_name
             AND tc.table_schema = kcu.table_schema
            JOIN information_schema.constraint_column_usage AS ccu
              ON ccu.constraint_name = tc.constraint_name
             AND ccu.table_schema = tc.table_schema
            WHERE tc.constraint_type = 'FOREIGN KEY'
              AND tc.table_schema = 'public'
              AND tc.table_name LIKE 'core_%'
              AND ccu.table_name LIKE 'core_%'
            ORDER BY tc.table_name, kcu.ordinal_position
            """
        )
        deps = {}
        tables = set()
        for src_table, src_col, ref_table, ref_col in cur.fetchall():
            tables.add(src_table)
            tables.add(ref_table)
            deps.setdefault(src_table, set()).add(ref_table)
        # asegurar entrada para todas
        for t in list(tables):
            deps.setdefault(t, set())
    # incluir tablas core_ sin FKs
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT table_name
            FROM information_schema.tables
            WHERE table_schema='public' AND table_type='BASE TABLE' AND table_name LIKE 'core_%'
            """
        )
        for (t,) in cur.fetchall():
            tables.add(t)
            deps.setdefault(t, set())
    return sorted(tables), deps


def topo_order(tables, deps):
    """Orden topológico de tablas basado en deps (a -> depende de)."""
    visited, temp, order = set(), set(), []
    def visit(n):
        if n in visited:
            return
        if n in temp:
            return  # ciclo; ignorar para no bloquear
        temp.add(n)
        for m in deps.get(n, ()):  # n depende de m
            visit(m)
        temp.remove(n)
        visited.add(n)
        order.append(n)
    for t in tables:
        visit(t)
    return order  # dependencias antes que dependientes


def pre_sync_all_core_refs(local_conn, cluster_params_list, exclude_tables=None):
    """Sincroniza por upsert todas las tablas core_ en orden de dependencias.
    exclude_tables: conjunto de tablas a excluir (ej: {'core_interactiondetail'}).
    cluster_params_list: lista de dicts de conexión a clusters destino."""
    if exclude_tables is None:
        exclude_tables = set()
    tables, deps = get_core_tables_and_deps(local_conn)
    order = topo_order(tables, deps)
    order = [t for t in order if t not in exclude_tables] + [t for t in order if t in exclude_tables]
    synced_total = 0
    for t in order:
        if t in exclude_tables:
            continue
        for params in cluster_params_list:
            try:
                with psycopg2.connect(**params) as cconn:
                    cnt = upsert_reference_table(local_conn, cconn, t)
                    synced_total += cnt
            except Exception as e:
                print(f"pre-sync {t}: error {e}")
    print(f"Pre-sync core_* completo. Filas upsert: {synced_total}")
    finally:
        # Ahora sí, cerrar recursos locales
        try:
            local_cursor.close()
        except Exception:
            pass
        try:
            local_conn.close()
        except Exception:
            pass
    return synced_total

