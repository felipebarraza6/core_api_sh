# 🌊 SMART HYDRO - ENVIRONMENT VARIABLES EXAMPLE
# Copia este archivo a .env y llena los valores reales

# ========================================
# DJANGO SETTINGS
# ========================================
DJANGO_SECRET_KEY=your_super_secret_key_here_32_chars_minimum
DJANGO_DEBUG=False
USE_CLUSTER=false

# ========================================
# DATABASE - LOCAL DEVELOPMENT
# ========================================
LOCAL_DB_HOST=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=postgres
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres

# ========================================
# DATABASE - DIGITALOCEAN CLUSTER
# ========================================
CLUSTER_DB_HOST=db-postgresql-nyc3-22918-do-user-7500906-0.m.db.ondigitalocean.com
CLUSTER_DB_PORT=25060
CLUSTER_DB_NAME=telemetry_api
CLUSTER_DB_USER=doadmin
CLUSTER_DB_PASSWORD=your_cluster_password_here
CLUSTER_DB_SSLMODE=require

# ========================================
# NOTAS IMPORTANTES:
# ========================================
# 1. NUNCA subas .env al repositorio (contiene credenciales reales)
# 2. env.example SÍ se sube (plantilla para otros desarrolladores)
# 3. Cambia CLUSTER_DB_PASSWORD por tu password real del cluster
# 4. Para desarrollo local, usa LOCAL_DB_* (valores por defecto)
# 5. Para producción, usa CLUSTER_DB_* (valores reales)
# 6. DJANGO_SECRET_KEY debe ser única y segura (32+ caracteres)
# 7. DJANGO_DEBUG=False en producción
# 8. USE_CLUSTER=true solo cuando quieras usar el cluster
# 9. Los valores por defecto están en settings.py
# 10. CLUSTER_DB_USER es 'doadmin' (usuario de DigitalOcean)
