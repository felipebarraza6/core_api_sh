# Variables de entorno para producción de SmartHydro
# COPIAR ESTE ARCHIVO A .env Y COMPLETAR LOS VALORES

# ========================================
# DJANGO SETTINGS
# ========================================
DJANGO_SECRET_KEY=tu_clave_secreta_muy_segura_aqui_32_caracteres_minimo
DJANGO_DEBUG=False
ENVIRONMENT=production

# ========================================
# DATABASE
# ========================================
POSTGRES_DB=smarthydro_prod
POSTGRES_USER=smarthydro_user
POSTGRES_PASSWORD=tu_password_muy_seguro_para_postgres

# ========================================
# REDIS
# ========================================
REDIS_URL=redis://redis:6379/0

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@tu-dominio.com
EMAIL_HOST_PASSWORD=tu_password_de_email
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=system@smarthydro.app
CONTACT_EMAIL=support@smarthydro.app

# ========================================
# MQTT BROKER CONFIGURATION
# ========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=smarthydro
MQTT_BROKER_PASSWORD=tu_password_mqtt_seguro

# ========================================
# EXTERNAL APIs
# ========================================
GEMINI_API_KEY=tu_api_key_de_google_gemini

# ========================================
# SSL CERTIFICATES PATH
# ========================================
SSL_CERT_PATH=/etc/ssl/certs/smarthydro.crt
SSL_KEY_PATH=/etc/ssl/private/smarthydro.key

# ========================================
# MONITORING
# ========================================
GRAFANA_ADMIN_PASSWORD=tu_password_grafana_seguro

# ========================================
# FEATURE FLAGS
# ========================================
USE_NEW_CELERY_SYSTEM=True
ENABLE_MQTT_INTEGRATION=True
ENABLE_ENHANCED_DATA_MODELS=True
ENABLE_SUPER_ADMIN=True

# ========================================
# SYSTEM LIMITS
# ========================================
MAX_API_REQUESTS_PER_MINUTE=1000
MAX_CELERY_WORKERS=8
MAX_MQTT_CONNECTIONS=1000
DATA_RETENTION_DAYS=365

# ========================================
# BACKUP CONFIGURATION
# ========================================
BACKUP_ENABLED=True
BACKUP_FREQUENCY_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=tu-bucket-s3-backups

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=100MB
LOG_RETENTION_DAYS=30

# ========================================
# SECURITY
# ========================================
ALLOWED_HOSTS=api.smarthydro.app,www.api.smarthydro.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.smarthydro.app,https://www.api.smarthydro.app
CORS_ALLOWED_ORIGINS=https://app.smarthydro.app,https://www.app.smarthydro.app

# ========================================
# PROVIDER SPECIFIC CONFIGS
# ========================================
NOVUS_API_KEY=tu_api_key_novus
TTN_APP_ID=tu_app_id_ttn
TWIN_API_TOKEN=tu_api_token_twin

# ========================================
# ALERTING
# ========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ========================================
# ANALYTICS
# ========================================
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=tu_mixpanel_token