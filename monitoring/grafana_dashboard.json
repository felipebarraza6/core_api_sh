{
  "dashboard": {
    "title": "SmartHydro Telemetry - Sistema Unificado V3.1",
    "tags": ["celery", "telemetry", "smarthydro"],
    "timezone": "America/Santiago",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Celery Workers - Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "celery_workers_active",
            "refId": "A",
            "legendFormat": "Workers Activos"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Tasks Procesados (Último minuto)",
        "type": "graph",
        "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(celery_tasks_total{state='SUCCESS'}[1m])",
            "refId": "A",
            "legendFormat": "✅ Exitosos"
          },
          {
            "expr": "rate(celery_tasks_total{state='FAILURE'}[1m])",
            "refId": "B",
            "legendFormat": "❌ Fallidos"
          },
          {
            "expr": "rate(celery_tasks_total{state='RETRY'}[1m])",
            "refId": "C",
            "legendFormat": "🔄 Reintentos"
          }
        ]
      },
      {
        "id": 3,
        "title": "Tasks por Frecuencia",
        "type": "piechart",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "celery_tasks_total{task=~'.*collect_telemetry.*'}",
            "refId": "A",
            "legendFormat": "{{task}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Latencia de Tasks (p95)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(celery_task_duration_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p95 Latency"
          },
          {
            "expr": "histogram_quantile(0.50, rate(celery_task_duration_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "p50 Latency"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Segundos"}
        ]
      },
      {
        "id": 5,
        "title": "Queue Size (Pending Tasks)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "celery_queue_length{queue='telemetry'}",
            "refId": "A",
            "legendFormat": "Telemetry Queue"
          },
          {
            "expr": "celery_queue_length{queue='dga'}",
            "refId": "B",
            "legendFormat": "DGA Queue"
          },
          {
            "expr": "celery_queue_length{queue='alerts'}",
            "refId": "C",
            "legendFormat": "Alerts Queue"
          }
        ]
      },
      {
        "id": 6,
        "title": "Redis - Memoria Usada",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "redis_memory_used_bytes / 1024 / 1024",
            "refId": "A",
            "legendFormat": "Memoria (MB)"
          }
        ],
        "yaxes": [
          {"format": "MB"}
        ]
      },
      {
        "id": 7,
        "title": "PostgreSQL - Conexiones Activas",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "refId": "A",
            "legendFormat": "Conexiones Activas"
          }
        ]
      },
      {
        "id": 8,
        "title": "Telemetry Records Created (Last Hour)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 22, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "increase(django_model_inserts_total{model='TelemetryRecord'}[1h])",
            "refId": "A",
            "legendFormat": "Registros Creados"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 100, "color": "yellow"},
                {"value": 1000, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Error Rate (Last 5min)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 22, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(celery_tasks_total{state='FAILURE'}[5m]) / rate(celery_tasks_total[5m]) * 100",
            "refId": "A",
            "legendFormat": "Error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Points Processed by Frequency",
        "type": "table",
        "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (frequency) (celery_tasks_total{task=~'.*collect_telemetry.*', state='SUCCESS'})",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "frequency": "Frecuencia",
                "Value": "Tasks Exitosos"
              }
            }
          }
        ]
      }
    ]
  }
}
